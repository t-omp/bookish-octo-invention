[Unit]
Description=Install APKs into Waydroid after Android session is ready
After=waydroid-session.target NetworkManager-wait-online.service
Requires=waydroid-session.target NetworkManager-wait-online.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/waydroid-apk-install.sh
RemainAfterExit=yes

# Ensure script can access Waydroid runtime
PrivateTmp=no
PrivateDevices=no
ProtectSystem=off
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
